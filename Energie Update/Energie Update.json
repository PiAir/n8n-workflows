    {
      "parameters": {
        "url": "http://192.168.0.11/api/v1/powergas/day?sort=asc&starttime=2024-01-01%2000:00:00",
        "options": {}
      },
      "executeOnce": true,
      "id": "http-powergas-day",
      "name": "HTTP PowerGas Day",
      "position": [
        512,
        208
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2
    },
    {
      "parameters": {
        "jsCode": "const weatherItems = $items(\"HTTP Weather Day\"); \nconst energyItems = $input.all(); \n\nconst weatherMap = {};\n// weatherItems is an array of objects like { json: [date, val, ...] }\nweatherItems.forEach(item => {\n    const row = item.json;\n    weatherMap[row[0]] = row[row.length-1]; \n});\n\nconst results = [];\n\nenergyItems.forEach(item => {\n   const row = item.json;\n   const dateStr = row[0];\n   if (!dateStr) return;\n\n   const gas = row[9];\n   const graaddag = weatherMap[dateStr];\n\n   if (graaddag !== undefined) {\n       const d = new Date(dateStr);\n       const day = String(d.getDate()).padStart(2, '0');\n       const month = String(d.getMonth() + 1).padStart(2, '0');\n       // Format: DD-MM-YYYY\n       const fmtDate = `${day}-${month}-${d.getFullYear()}`;\n\n       const res = {\n           \"Dag\": fmtDate,\n           \"Graaddag\": parseFloat(graaddag.toFixed(3)),\n           \"m3\": parseFloat(gas.toFixed(3)),\n           \"m3 / GD\": graaddag > 0 ? parseFloat((gas / graaddag).toFixed(2)) : 0,\n           \"max m3\": Math.round(graaddag * 0.65)\n       };\n       results.push({json: res});\n   }\n});\n\n// LIMIT TO 50 ITEMS FOR TESTING (Avoiding loops/rate limits)\n// return results.slice(0, 50);\nreturn results;"
      },
