    {
      "parameters": {
        "jsCode": "const inputItems = $input.all(); \n\nconst months = [\"Januari\", \"Februari\", \"Maart\", \"April\", \"Mei\", \"Juni\", \"Juli\", \"Augustus\", \"September\", \"Oktober\", \"November\", \"December\"];\n\nconst results = [];\n\ninputItems.forEach(item => {\n    const row = item.json;\n    const dateStr = row[0];\n    if (!dateStr) return;\n    \n    const d = new Date(dateStr);\n\n    const gas = Math.round(row[9]);\n    const stroom = Math.round(row[6]);\n    const terug = Math.round(row[7]); \n    const totaal = stroom - terug;\n\n    results.push({\n        json: {\n            \"Maand\": months[d.getMonth()],\n            \"Jaar\": d.getFullYear(), // number ok for append/user_entered\n            \"Gas\": gas,\n            \"Stroom\": stroom,\n            \"Teruglevering\": terug,\n            \"Totaal\": totaal,\n            // \"Water\" ignored\n        }\n    });\n});\nreturn results;"
      },
